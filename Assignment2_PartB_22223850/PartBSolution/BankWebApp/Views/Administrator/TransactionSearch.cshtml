@using BankWebApp.Models.ViewModels.Administrator
@model AdminTransactionSearchVM

@{
    ViewData["Title"] = "Transaction Search";
}

<h2>Transaction Search</h2>

<form asp-controller="Administrator"
      asp-action="TransactionSearch"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="card p-3 mb-3">

        <div class="row">

            <div class="col-md-3">
                <label asp-for="AccountNumber"
                       class="form-label">
                    Account Number
                </label>

                <input asp-for="AccountNumber"
                       class="form-control" />

                <span asp-validation-for="AccountNumber"
                      class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="StartDate"
                       class="form-label">
                    Start Date
                </label>

                <input asp-for="StartDate"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label asp-for="EndDate"
                       class="form-label">
                    End Date
                </label>

                <input asp-for="EndDate"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label asp-for="SortOrder"
                       class="form-label">
                    Sort By
                </label>

                <select asp-for="SortOrder"
                        class="form-select">

                    <option value="date_desc">
                        Date - Newest First
                    </option>

                    <option value="date_asc">
                        Date - Oldest First
                    </option>

                    <option value="amount_desc">
                        Amount - Highest First
                    </option>

                    <option value="amount_asc">
                        Amount - Lowest First
                    </option>

                </select>
            </div>

        </div>

        <div class="mt-3">

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-controller="Administrator"
               asp-action="TransactionSearch"
               class="btn btn-secondary">
                Clear
            </a>

            <a asp-controller="Administrator"
               asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

    @if (Model.SearchPerformed)
    {
        <h3>Transaction Results</h3>

        @if (ViewData.ModelState.IsValid && Model.Transactions.Count == 0)
        {
            <div class="alert alert-warning">
                No transactions found.
            </div>
        }
        else if (Model.Transactions.Count > 0)
        {
            <table class="table table-striped">

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Amount</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var transaction in Model.Transactions)
                    {
                        <tr>
                            <td>
                                @transaction.TimeStamp.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @transaction.Type
                            </td>

                            <td>
                                @transaction.Description
                            </td>

                            <td>
                                @transaction.Amount.ToString("C")
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Transaction search pages">

                    <ul class="pagination">

                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">

                            <button type="submit"
                                    name="CurrentPage"
                                    value="@(Model.CurrentPage - 1)"
                                    class="page-link">
                                Previous
                            </button>

                        </li>

                        <li class="page-item disabled">

                            <span class="page-link">
                                Page @Model.CurrentPage of @Model.TotalPages
                            </span>

                        </li>

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">

                            <button type="submit"
                                    name="CurrentPage"
                                    value="@(Model.CurrentPage + 1)"
                                    class="page-link">
                                Next
                            </button>

                        </li>

                    </ul>

                </nav>
            }
        }
    }

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}