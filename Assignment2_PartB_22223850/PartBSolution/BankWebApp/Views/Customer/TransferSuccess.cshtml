@{
    ViewData["Title"] = "Transfer Successful";
}

<h2>Transfer Successful</h2>

@if (TempData["TransferMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["TransferMessage"]
    </div>
}

<div class="mt-3">
    <a asp-controller="Customer" asp-action="Transfer" class="btn btn-primary">
        Make Another Transfer
    </a>

    <a asp-controller="Customer" asp-action="Index" class="btn btn-secondary">
        Back to Customer Menu
    </a>
</div>